# Cloudflare Pages redirects for the production custom domain.
# The admin panel is served by the Worker, not by Pages — the Pages project only
# hosts the marketing site. Send /admin requests to the Worker so a missing page
# can never be mistaken for the admin panel. Preview hosts that do not apply
# _redirects (for example freebuff.page) still need the direct Worker link.
/admin     https://davenport-host-co-bot.davenport-host-co-bot.workers.dev/admin            301
/admin/    https://davenport-host-co-bot.davenport-host-co-bot.workers.dev/admin            301
/admin/*   https://davenport-host-co-bot.davenport-host-co-bot.workers.dev/admin/:splat    301

# The host portal is also served by the Worker. A 302 rather than a 301 keeps
# this movable when the custom domain is attached.
/host      https://davenport-host-co-bot.davenport-host-co-bot.workers.dev/host          302
/host/     https://davenport-host-co-bot.davenport-host-co-bot.workers.dev/host          302
